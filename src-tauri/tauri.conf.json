{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ATM",
  "version": "1.0.0",
  "identifier": "team.akaal.id",
  "build": {
    "frontendDist": "https://team.akaal.id",
    "devUrl": "https://team.akaal.id"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATM",
        "url": "https://team.akaal.id/dashboard",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Akaal Corp",
    "copyright": "© 2026 Akaal Corp",
    "category": "Productivity",
    "shortDescription": "Akaal Team Management",
    "longDescription": "Akaal Team Management — tasks, attendance, chat, and leaderboard for the Akaal team.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "android": {
      "minSdkVersion": 26,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
